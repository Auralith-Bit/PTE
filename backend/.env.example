APP_NAME=PTE-AI Backend
APP_VERSION=0.1.0
DEBUG=false
# "development" | "staging" | "production". Production refuses to start on the
# default or a short JWT_SECRET_KEY.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PTE_AI
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PTE_AI_test

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# OAuth sign-in. The Google/Facebook buttons render disabled until BOTH values
# for that provider are set, then they become live automatically.
# The redirect URI registered with the provider must be exactly:
#   {BACKEND_PUBLIC_URL}/api/v1/auth/oauth/google/callback
#   {BACKEND_PUBLIC_URL}/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Sign in with Apple (needed for App Store review whenever other social sign-ins
# are offered, and expected by users on iOS). In the Apple Developer portal:
#   1. Create a Services ID (Services IDs > Add) and enable Sign in with Apple.
#   2. Add the return URL, exactly:
#      {BACKEND_PUBLIC_URL}/api/v1/auth/oauth/apple/callback
#   3. Create a key (Keys > Add) and download the .p8 file once.
# Apple wants a short-lived ES256 client secret, so give it the signing key
# rather than a fixed secret: the backend mints a fresh secret per request.
# APPLE_CLIENT_ID is the Services ID, e.g. com.example.pteprep.web
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Either paste the .p8 contents here (literal \n escapes are fine)
APPLE_PRIVATE_KEY=
# ...or point at the downloaded file instead
APPLE_PRIVATE_KEY_PATH=
# Only needed if you mint the client secret JWT somewhere else yourself.
APPLE_CLIENT_SECRET=
# A native iOS build signs in with its bundle id rather than the Services ID.
# List it here to accept both audiences, e.g. com.example.pteprep
APPLE_AUDIENCES=

# Password reset. The emailed link is {FRONTEND_URL}/reset-password?token=...
PASSWORD_RESET_TTL_MINUTES=60

# Outbound email. Leave SMTP_HOST empty in development: reset emails are then
# written to the backend log instead of being sent, so the flow stays testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@pteprep.local
SMTP_USE_STARTTLS=true
