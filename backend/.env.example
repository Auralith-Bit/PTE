APP_NAME=PTE-AI Backend
APP_VERSION=0.1.0
DEBUG=false

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PTE_AI
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/PTE_AI_test

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# OAuth sign-in. The Google/Facebook buttons render disabled until BOTH values
# for that provider are set, then they become live automatically.
# The redirect URI registered with the provider must be exactly:
#   {BACKEND_PUBLIC_URL}/api/v1/auth/oauth/google/callback
#   {BACKEND_PUBLIC_URL}/api/v1/auth/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
